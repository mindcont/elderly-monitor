# Copy to .env on the target device. Never commit the real .env.
CAMERA_ID=living_room
RTSP_URL=rtsp://user:password@camera-ip:554/path
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=pi_elderly
MQTT_PASSWORD=change-me
MQTT_TOPIC=home/ai/living_room/event
MODEL_PARAM=models/yolo11n.ncnn.param
MODEL_BIN=models/yolo11n.ncnn.bin
MODEL_INPUT_SIZE=320
GST_LATENCY_MS=200
REPORT_INTERVAL_SEC=10
INFERENCE_INTERVAL_MS=1000
ABSENCE_TIMEOUT_SEC=300
